---
import { site } from '../data/site';
import { getPosts } from '../lib/content';

const hasPosts = (await getPosts()).length > 0;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <p class="label">© {year} {site.name}</p>
    <ul role="list">
      <li><a href={`mailto:${site.email}`}>Email</a></li>
      <li><a href={site.links.linkedin} rel="me noopener">LinkedIn</a></li>
      <li><a href={site.links.github} rel="me noopener">GitHub</a></li>
      {hasPosts && <li><a href="/rss.xml">RSS</a></li>}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(3rem, 8vw, 6rem);
    border-top: 1px solid var(--rule);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.75rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  a {
    font-size: 0.95rem;
    color: var(--ink-2);
    text-decoration: none;
  }

  a:hover {
    color: var(--accent);
  }
</style>
