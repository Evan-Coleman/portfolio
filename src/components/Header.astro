---
import { site } from '../data/site';
import { getPosts, getProjects } from '../lib/content';

// Sections only appear in the nav once they have something in them.
const [posts, projects] = await Promise.all([getPosts(), getProjects()]);

const nav = [
  { href: '/', label: 'Home' },
  projects.length > 0 && { href: '/projects', label: 'Projects' },
  posts.length > 0 && { href: '/blog', label: 'Writing' },
  { href: '/resume', label: 'Résumé' },
].filter((item) => item !== false);

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="wordmark" href="/" aria-label={`${site.name}, home`}>{site.name}</a>
    <nav aria-label="Main">
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
      <button class="theme-toggle" type="button" aria-label="Switch between light and dark theme">
        <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path
            d="M20 14.5A8.5 8.5 0 0 1 9.5 4a7 7 0 1 0 10.5 10.5Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linejoin="round"></path>
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
          <path
            d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"></path>
        </svg>
      </button>
  </div>
</header>

<script is:inline>
  document.querySelector('.theme-toggle')?.addEventListener('click', function () {
    var root = document.documentElement;
    var current = root.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    var next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch (e) {}
  });
</script>

<style>
  /* The bar stays pinned while the page scrolls, so the current page is always in view. */
  .site-header {
    position: sticky;
    /* Small screens: the name row scrolls away and only the link row stays pinned. */
    top: -3.5rem;
    z-index: 20;
    background: color-mix(in srgb, var(--paper) 90%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
    view-transition-name: site-header;
  }

  /* Small screens: wordmark and toggle on one row, links on the next. */
  .site-header__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: 2.25rem auto;
    grid-template-areas:
      'wordmark toggle'
      'nav nav';
    align-items: center;
    gap: 0.5rem 1rem;
    padding-block: 0.75rem 0.4rem;
  }

  .wordmark {
    grid-area: wordmark;
    justify-self: start;
  }

  nav {
    grid-area: nav;
  }

  .theme-toggle {
    grid-area: toggle;
  }

  @media (min-width: 36rem) {
    .site-header {
      top: 0;
    }

    .site-header__inner {
      grid-template-columns: minmax(0, 1fr) auto auto;
      grid-template-rows: auto;
      grid-template-areas: 'wordmark nav toggle';
      gap: 1rem;
      padding-block: 0.85rem;
    }
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }

  ul {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 3vw, 1.75rem);
  }

  nav a {
    display: inline-block;
    font-size: 0.95rem;
    color: var(--ink-2);
    text-decoration: none;
    padding-block: 0.35rem;
    border-bottom: 2px solid transparent;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
  }

  /* The page you are on: full-strength text and an accent underline. */
  nav a[aria-current='page'] {
    font-weight: 500;
    border-bottom-color: var(--accent);
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-right: -0.5rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--ink-2);
    cursor: pointer;
  }

  .theme-toggle:hover {
    background: var(--accent-wash);
    color: var(--accent);
  }

  /* Show the icon for the theme you would switch to. */
  .icon-sun {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon-sun {
      display: block;
    }
    :global(:root:not([data-theme='light'])) .icon-moon {
      display: none;
    }
  }

  :global(:root[data-theme='dark']) .icon-sun {
    display: block;
  }
  :global(:root[data-theme='dark']) .icon-moon {
    display: none;
  }
</style>
