---
import { site } from '../data/site';
import { getPosts, getProjects } from '../lib/content';

// Sections only appear in the nav once they have something in them.
const [posts, projects] = await Promise.all([getPosts(), getProjects()]);

const nav = [
  { href: '/', label: 'Home' },
  projects.length > 0 && { href: '/projects', label: 'Projects' },
  posts.length > 0 && { href: '/blog', label: 'Writing' },
  { href: '/resume', label: 'Résumé' },
].filter((item) => item !== false);

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="wordmark" href="/" aria-label={`${site.name}, home`}>{site.name}</a>
    <nav aria-label="Main">
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <button class="theme-toggle" type="button" aria-label="Switch between light and dark theme">
      <svg class="icon-moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <path
          d="M20 14.5A8.5 8.5 0 0 1 9.5 4a7 7 0 1 0 10.5 10.5Z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linejoin="round"></path>
      </svg>
      <svg class="icon-sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.75"></circle>
        <path
          d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
</header>

<script is:inline>
  document.querySelector('.theme-toggle')?.addEventListener('click', function () {
    var root = document.documentElement;
    var current = root.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    var next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch (e) {}
  });
</script>

<style>
  /* The bar stays pinned while the page scrolls, so the current page is always in view. */
  .site-header {
    --name-row: 2.75rem;
    --link-row: 2.5rem;
    --link: 1.75rem;
    position: sticky;
    /* Small screens: the name row scrolls away and only the link row stays pinned. */
    top: calc(-1 * var(--name-row));
    z-index: 20;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }

  /* Small screens: name and toggle on one row, links on the next. */
  .site-header__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: var(--name-row) var(--link-row);
    grid-template-areas:
      'wordmark toggle'
      'nav nav';
    align-items: center;
    column-gap: 0.5rem;
  }

  @media (min-width: 36rem) {
    .site-header {
      --link-row: 3.25rem;
      top: 0;
    }

    .site-header__inner {
      grid-template-columns: minmax(0, 1fr) auto auto;
      grid-template-rows: var(--link-row);
      grid-template-areas: 'wordmark nav toggle';
    }
  }

  @media (pointer: coarse) {
    .site-header {
      --link: 2.25rem;
    }
  }

  .wordmark {
    grid-area: wordmark;
    justify-self: start;
    font-size: var(--text-md);
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }

  .wordmark:hover {
    color: inherit;
  }

  nav {
    grid-area: nav;
  }

  /* Links carry their own padding, so the list is pulled left to keep the text on the page edge. */
  ul {
    display: flex;
    gap: 0.25rem;
    margin-left: -0.5rem;
  }

  nav a {
    position: relative;
    display: flex;
    align-items: center;
    height: var(--link);
    padding-inline: 0.5rem;
    border-radius: 4px;
    font-size: var(--text-sm);
    color: var(--ink-2);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
  }

  /* The page you are on: full-strength text, and an accent rule that sits on the header's own. */
  nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    inset-inline: 0.5rem;
    bottom: calc((var(--link) - var(--link-row)) / 2 - 1px);
    height: 2px;
    background: var(--accent);
  }

  .theme-toggle {
    grid-area: toggle;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin-right: -0.5rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: none;
    color: var(--ink-2);
    cursor: pointer;
    transition: color 0.12s ease, background 0.12s ease;
  }

  .theme-toggle:hover {
    background: var(--inset);
    color: var(--ink);
  }

  @media (pointer: coarse) {
    .theme-toggle {
      width: 2.5rem;
      height: 2.5rem;
      margin-right: -0.75rem;
    }
  }

  /* Show the icon for the theme you would switch to. */
  .icon-sun {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon-sun {
      display: block;
    }
    :global(:root:not([data-theme='light'])) .icon-moon {
      display: none;
    }
  }

  :global(:root[data-theme='dark']) .icon-sun {
    display: block;
  }
  :global(:root[data-theme='dark']) .icon-moon {
    display: none;
  }
</style>
