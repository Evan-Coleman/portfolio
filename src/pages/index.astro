---
import Base from '../layouts/Base.astro';
import ProjectList from '../components/ProjectList.astro';
import PostList from '../components/PostList.astro';
import { site } from '../data/site';
import { roles, yearRange } from '../data/resume';
import { getPosts, getProjects } from '../lib/content';

const [posts, projects] = await Promise.all([getPosts(), getProjects()]);
const latestPosts = posts.slice(0, 3);

const facts = [
  { term: 'Now', detail: `${roles[0].title}, ${roles[0].company}` },
  { term: 'Scale', detail: '9 services, about 30 million API requests a day' },
  { term: 'Stack', detail: 'Java · Spring Boot · AWS · Kubernetes' },
  { term: 'Lately', detail: 'A CLI that cut team onboarding from months to hours' },
  { term: 'Location', detail: site.location },
  { term: 'Citizenship', detail: site.availability },
];
---

<Base>
  <div class="wrap">
    <header class="hero">
      <h1>I lead the team behind the services everyone else builds on.</h1>
      <p class="lede">
        I’m Evan, a lead software engineer at State Farm. I built nine backend services from the ground up for the
        company’s move off legacy systems, and I now lead the eight engineers who run them in production at about 30
        million API requests a day. I care about services that stay fast under load, deploys that are uneventful, and
        engineers who get better because of the team they’re on.
      </p>
      <p class="actions">
        <a class="btn" href="/resume">Read my résumé</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.links.linkedin} rel="me noopener">LinkedIn</a>
        <a href={site.links.github} rel="me noopener">GitHub</a>
      </p>
    </header>

    <section aria-label="At a glance">
      <dl class="facts">
        {
          facts.map((fact) => (
            <div>
              <dt>{fact.term}</dt>
              <dd>{fact.detail}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="section" id="experience" aria-labelledby="experience-label">
      <h2 class="label" id="experience-label">Experience</h2>
      <div>
        <ol class="entries" role="list">
          {
            roles.map((role) => (
              <li class="entry">
                <div class="entry__head">
                  <h3 class="entry__title">{role.title}</h3>
                  <p class="entry__date">{yearRange(role)}</p>
                </div>
                <p class="entry__sub">
                  {role.company}
                  {role.note && ` (${role.note})`}
                </p>
                <p class="entry__text">{role.summary}</p>
              </li>
            ))
          }
        </ol>
        <p class="section__more"><a href="/resume">Full résumé</a></p>
      </div>
    </section>

    {
      projects.length > 0 && (
        <section class="section" id="projects" aria-labelledby="projects-label">
          <h2 class="label" id="projects-label">Projects</h2>
          <ProjectList projects={projects} />
        </section>
      )
    }

    {
      latestPosts.length > 0 && (
        <section class="section" id="writing" aria-labelledby="writing-label">
          <h2 class="label" id="writing-label">Writing</h2>
          <div>
            <PostList posts={latestPosts} />
            {posts.length > latestPosts.length && (
              <p class="section__more">
                <a href="/blog">All writing</a>
              </p>
            )}
          </div>
        </section>
      )
    }

    <section class="section" id="about" aria-labelledby="about-label">
      <h2 class="label" id="about-label">About</h2>
      <div class="about">
        <p>
          I studied computer science and German at Washington State University, and I’ve spent the years since on the
          backend of large insurance systems: Guidewire PolicyCenter first, then the Spring Boot services that are
          replacing it. The work I enjoy most is algorithmic and on the backend, especially making something slow fast.
        </p>
        <p>
          Lately much of my work is making AI coding agents useful to a whole team: one repository that holds what
          the team knows in a form an agent can search, shared skills that encode our standards, and a command-line
          tool that sets all of it up on a new machine in a few hours.
        </p>
        <p>Away from the keyboard I’m usually watching films, fussing over audio gear, or playing games.</p>
      </div>
    </section>

    <section class="section" id="contact" aria-labelledby="contact-label">
      <h2 class="label" id="contact-label">Contact</h2>
      <div>
        <p>I’m always interested in hearing about new opportunities.</p>
        <ul class="dotted contact__links">
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={site.links.linkedin} rel="me noopener">LinkedIn</a></li>
          <li><a href={site.links.github} rel="me noopener">GitHub</a></li>
        </ul>
      </div>
    </section>
  </div>
</Base>

<style>
  .hero {
    padding-block: 2.5rem 2.25rem;
  }

  h1 {
    max-width: 20em;
    font-size: var(--text-2xl);
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  @media (min-width: 44rem) {
    .hero {
      padding-block: 4rem 2.5rem;
    }

    h1 {
      font-size: var(--text-3xl);
      line-height: 1.1;
      letter-spacing: -0.03em;
    }
  }

  .lede {
    margin-top: 1rem;
  }

  .actions {
    margin-top: 1.5rem;
  }

  .about {
    max-width: var(--measure);
  }

  .about p + p {
    margin-top: 0.85em;
  }

  .contact__links {
    margin-top: 0.4rem;
  }
</style>
