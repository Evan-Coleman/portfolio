---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" noindex>
  <div class="wrap">
    <header class="page-head">
      <p class="label">404</p>
      <h1>Page not found</h1>
      <p class="lede">That page doesn’t exist or has moved.</p>
      <p class="actions"><a href="/">Back to the home page</a></p>
    </header>
  </div>
</Base>

<style>
  h1 {
    margin-top: 0.5rem;
  }
</style>
