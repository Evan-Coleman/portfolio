---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { headline, summary, roles, skills, sideProjects, education, monthRange } from '../data/resume';

const bare = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<Base title="Résumé" description={`Résumé of ${site.name}, ${site.role}.`}>
  <div class="wrap">
    <header class="head">
      <h1>{site.name}</h1>
      <p class="head__role">{headline}</p>
      <p class="contact muted">
        <span>{site.location}</span>
        <span aria-hidden="true">·</span>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <span aria-hidden="true">·</span>
        <a href={site.links.linkedin} rel="me noopener">
          <span class="screen-only">LinkedIn</span>
          <span class="print-only">{bare(site.links.linkedin)}</span>
        </a>
        <span class="screen-only" aria-hidden="true">·</span>
        <a class="screen-only" href={site.links.github} rel="me noopener">GitHub</a>
        <span class="print-only" aria-hidden="true">·</span>
        <span class="print-only">{bare(site.url)}</span>
      </p>
      <p class="auth muted">{site.workAuthorization.join(' · ')}</p>
      <p class="actions no-print">
        <a class="btn" href="/res/Evan-Coleman-Resume.pdf" download>Download PDF</a>
        <a class="btn btn--ghost" href={`mailto:${site.email}`}>Email me</a>
      </p>
      <p class="alt muted no-print">
        Also available as{' '}
        <a href="/res/Evan-Coleman-Resume.docx" download>Word</a>{' '}
        or <a href="/res/Evan-Coleman-Resume.txt">plain text</a>.
      </p>
    </header>

    <section class="section" aria-labelledby="summary-label">
      <h2 class="label" id="summary-label">Summary</h2>
      <p class="lede summary">{summary}</p>
    </section>

    <section class="section" aria-labelledby="experience-label">
      <h2 class="label" id="experience-label">Experience</h2>
      <ol class="roles" role="list">
        {
          roles.map((role) => (
            <li class="role">
              <div class="role__head">
                <h3>
                  {role.title}
                  <span class="role__company">
                    {role.company}
                    {role.note && ` (${role.note})`}
                    <span class="role__place"> · {role.location}</span>
                  </span>
                </h3>
                <p class="label">{monthRange(role)}</p>
              </div>
              <ul class="role__list">
                {role.highlights.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section" aria-labelledby="skills-label">
      <h2 class="label" id="skills-label">Skills</h2>
      <dl class="skills">
        {
          skills.map((group) => (
            <div>
              <dt>{group.label}</dt>
              <dd>{group.items.join(', ')}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    {
      sideProjects.length > 0 && (
        <section class="section" aria-labelledby="projects-label">
          <h2 class="label" id="projects-label">Projects</h2>
          <div class="projects">
            {sideProjects.map((p) => (
              <div>
                <p class="edu__school">
                  {p.link ? <a href={`https://${p.link}`} rel="noopener">{p.name}</a> : p.name}
                </p>
                <p class="muted">{p.detail}</p>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <section class="section last" aria-labelledby="education-label">
      <h2 class="label" id="education-label">Education</h2>
      <div>
        <p class="edu__school">{education.school}</p>
        <p class="muted">{education.degree} · {education.detail} · {education.year}</p>
      </div>
    </section>
  </div>
</Base>

<style>
  .print-only {
    display: none;
  }

  .role__place {
    font-weight: 400;
  }

  .head {
    padding-block: clamp(3rem, 8vw, 5.5rem) clamp(2rem, 5vw, 3rem);
  }

  h1 {
    font-size: var(--step-4);
    font-weight: 380;
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .head__role {
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--ink-2);
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin-top: 1.25rem;
  }

  .auth {
    margin-top: 0.35rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .alt {
    margin-top: 0.9rem;
    font-size: var(--step--1);
  }

  .alt a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .roles {
    display: grid;
    gap: 2.5rem;
    margin: 0;
    padding: 0;
  }

  .role__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
  }

  .role h3 {
    font-size: var(--step-2);
    letter-spacing: -0.02em;
  }

  .role__company {
    display: block;
    margin-top: 0.3rem;
    font-family: var(--font-text);
    font-size: var(--step-0);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--ink-2);
  }

  .role__list {
    margin: 0.9rem 0 0;
    padding-left: 1.25em;
    max-width: var(--measure);
    color: var(--ink-2);
  }

  .role__list li + li {
    margin-top: 0.4em;
  }

  .role__list li::marker {
    color: var(--ink-3);
  }

  .skills {
    display: grid;
    gap: 0.9rem;
    margin: 0;
  }

  .skills dt {
    font-weight: 500;
  }

  .skills dd {
    margin: 0.1rem 0 0;
    color: var(--ink-2);
  }

  .edu__school {
    font-weight: 500;
  }

  .projects {
    display: grid;
    gap: 0.9rem;
  }

  .projects .muted {
    margin-top: 0.1rem;
  }

  .last {
    margin-bottom: 3rem;
  }

  @media print {
    .print-only {
      display: inline;
    }

    .screen-only {
      display: none;
    }

    .head {
      padding-block: 0 0.2rem;
    }

    h1 {
      font-size: 18pt;
    }

    .head__role {
      margin-top: 0.1rem;
      font-size: 10pt;
    }

    .summary {
      font-size: 9pt;
      line-height: 1.25;
    }

    .contact {
      margin-top: 0.3rem;
    }

    .auth {
      margin-top: 0;
    }

    .section {
      padding-block: 0.15rem;
      gap: 0;
    }

    .roles {
      gap: 0.2rem;
    }

    .role {
      break-inside: avoid;
    }

    .role h3 {
      font-size: 10.5pt;
    }

    .role__list {
      margin-top: 0.1rem;
      max-width: none;
      font-size: 9pt;
      line-height: 1.2;
    }

    .role__list li + li {
      margin-top: 0.05em;
    }

    .role__head {
      flex-wrap: nowrap;
    }

    .role__head .label {
      font-size: 8pt;
      white-space: nowrap;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    .last {
      margin-bottom: 0;
    }

    .role__company {
      margin-top: 0;
      font-size: 9pt;
    }

    .projects {
      gap: 0.2rem;
    }

    .projects > div {
      break-inside: avoid;
    }

    .projects .muted {
      margin-top: 0;
      line-height: 1.2;
    }

    .skills,
    .edu__school,
    .projects .muted,
    .section.last .muted {
      font-size: 9pt;
    }

    /* Education on a single line. */
    .section.last > div {
      display: flex;
      flex-wrap: wrap;
      gap: 0 0.75rem;
    }

    /* Keep a section label with the content under it. */
    .section > .label {
      break-after: avoid;
      padding-top: 0;
      line-height: 1.3;
    }

    .section:has(.skills),
    .section.last {
      break-inside: avoid;
    }

    /* Skills as compact "label  items" rows. */
    .skills {
      gap: 0.05rem;
    }

    .skills > div {
      display: grid;
      grid-template-columns: 10rem minmax(0, 1fr);
      gap: 0.75rem;
    }

    .skills dd {
      margin: 0;
    }
  }
</style>
