---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { headline, summary, roles, skills, sideProjects, education, monthRange } from '../data/resume';

const bare = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<Base title="Résumé" description={`Résumé of ${site.name}, ${site.role}.`}>
  <div class="wrap">
    <header class="page-head head">
      <h1>{site.name}</h1>
      <p class="head__role">{headline}</p>
      <p class="actions no-print">
        <a class="btn" href="/res/Evan-Coleman-Resume.pdf" download>Download PDF</a>
        <span class="alt">
          Also available as <a href="/res/Evan-Coleman-Resume.docx" download>Word</a> or <a href="/res/Evan-Coleman-Resume.txt">plain text</a>.
        </span>
      </p>
    </header>

    <dl class="facts head__facts">
      <div>
        <dt>Location</dt>
        <dd>{site.location}</dd>
      </div>
      <div>
        <dt>Contact</dt>
        <dd class="contact">
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <span class="dot" aria-hidden="true">·</span>
          <a href={site.links.linkedin} rel="me noopener">
            <span class="screen-only">LinkedIn</span>
            <span class="print-only">{bare(site.links.linkedin)}</span>
          </a>
          <span class="dot" aria-hidden="true">·</span>
          <a class="screen-only" href={site.links.github} rel="me noopener">GitHub</a>
          <span class="print-only">{bare(site.url)}</span>
        </dd>
      </div>
      <div>
        <dt>Work authorization</dt>
        <dd>
          <ul class="auth" role="list">
            {site.workAuthorization.map((line) => <li>{line}</li>)}
          </ul>
        </dd>
      </div>
    </dl>

    <section class="section" aria-labelledby="summary-label">
      <h2 class="label" id="summary-label">Summary</h2>
      <p class="summary">{summary}</p>
    </section>

    <section class="section" aria-labelledby="experience-label">
      <h2 class="label" id="experience-label">Experience</h2>
      <ol class="entries roles" role="list">
        {
          roles.map((role) => (
            <li class="entry role">
              <div class="entry__head">
                <h3 class="entry__title">{role.title}</h3>
                <p class="entry__date">{monthRange(role)}</p>
              </div>
              <p class="entry__sub">
                {role.company}
                {role.note && ` (${role.note})`} · {role.location}
              </p>
              <ul class="role__list">
                {role.highlights.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section" aria-labelledby="skills-label">
      <h2 class="label" id="skills-label">Skills</h2>
      <dl class="skills">
        {
          skills.map((group) => (
            <div>
              <dt>{group.label}</dt>
              <dd>{group.items.join(', ')}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    {
      sideProjects.length > 0 && (
        <section class="section" aria-labelledby="projects-label">
          <h2 class="label" id="projects-label">Projects</h2>
          <div class="items">
            {sideProjects.map((p) => (
              <div>
                <p class="item__name">
                  {p.link ? <a href={`https://${p.link}`} rel="noopener">{p.name}</a> : p.name}
                  {p.link && <span class="print-only item__url"> ({p.link})</span>}
                </p>
                <p class="item__text">{p.detail}</p>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <section class="section education" aria-labelledby="education-label">
      <h2 class="label" id="education-label">Education</h2>
      <div>
        <p class="item__name">{education.school}</p>
        <p class="item__text">{education.degree} · {education.detail} · {education.year}</p>
      </div>
    </section>
  </div>
</Base>

<style>
  .print-only {
    display: none;
  }

  .head__role {
    margin-top: 0.3rem;
    font-size: var(--text-lg);
    color: var(--ink-2);
  }

  .alt {
    font-size: var(--text-sm);
    color: var(--ink-2);
  }

  /* "Work authorization" is too long for the narrow key column on a phone. */
  @media (max-width: 43.99rem) {
    .head__facts {
      gap: 0.75rem;
    }

    .head__facts > div {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.3em;
  }

  .dot {
    color: var(--ink-3);
  }

  .summary {
    max-width: var(--measure);
  }

  .roles {
    gap: 1.75rem;
  }

  .role__list {
    margin: 0.5rem 0 0;
    padding-left: 1.1em;
    list-style: disc;
    font-size: var(--text-md);
    line-height: 1.55;
  }

  .role__list li + li {
    margin-top: 0.3em;
  }

  .role__list li::marker {
    color: var(--ink-3);
  }

  .skills,
  .items {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }

  .skills dt,
  .item__name {
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .skills dd,
  .item__text {
    margin: 0;
    font-size: var(--text-md);
  }

  @media print {
    .print-only {
      display: inline;
    }

    .screen-only {
      display: none;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    .head {
      padding-block: 0 0.2rem;
    }

    .head h1 {
      font-size: 18pt;
      line-height: 1.15;
    }

    .head__role {
      margin-top: 0;
      font-size: 10pt;
    }

    /* Location and contact share a line; work authorization takes the next. */
    .head__facts {
      display: block;
      padding-block: 0 0.3rem;
      border: 0;
    }

    .head__facts > div {
      display: inline;
    }

    .head__facts > div:last-child {
      display: block;
    }

    .head__facts dt {
      display: none;
    }

    .head__facts dd,
    .contact,
    .auth,
    .auth li {
      display: inline;
    }

    .head__facts > div:first-child dd::after {
      content: ' · ';
    }

    .dot {
      margin-inline: 0.25em;
    }

    .auth li + li::before {
      content: ' · ';
    }

    /* One column on paper: each label sits above its section. */
    .section {
      display: block;
      padding-block: 0.25rem;
    }

    /* Keep a section label with the content under it. */
    .section > .label {
      position: static;
      break-after: avoid;
      font-family: var(--font-sans);
      font-size: 7.5pt;
      font-weight: 600;
      line-height: 1.5;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink);
    }

    .summary {
      max-width: none;
      line-height: 1.25;
    }

    .roles {
      gap: 0.3rem;
    }

    .role {
      break-inside: avoid;
    }

    .entry__head {
      flex-wrap: nowrap;
    }

    .entry__title {
      font-size: 10pt;
      line-height: 1.3;
    }

    .entry__date {
      font-size: 8pt;
      line-height: 1.3;
    }

    .entry__sub {
      font-size: 9pt;
    }

    .role__list {
      margin-top: 0.1rem;
      font-size: 9pt;
      line-height: 1.2;
    }

    .role__list li + li {
      margin-top: 0.05em;
    }

    .skills dt,
    .skills dd,
    .item__name,
    .item__text {
      font-size: 9pt;
    }

    .item__text {
      line-height: 1.2;
    }

    .item__url {
      font-weight: 400;
    }

    /* Skills as compact "label  items" rows. */
    .skills {
      gap: 0.05rem;
    }

    .skills > div {
      display: grid;
      grid-template-columns: 10rem minmax(0, 1fr);
      gap: 0.75rem;
    }

    .items {
      gap: 0.2rem;
    }

    .items > div {
      break-inside: avoid;
    }

    .section:has(.skills),
    .education {
      break-inside: avoid;
    }

    /* Education on a single line. */
    .education > div {
      display: flex;
      flex-wrap: wrap;
      gap: 0 0.75rem;
    }
  }
</style>
