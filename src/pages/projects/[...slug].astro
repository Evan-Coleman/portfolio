---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, role, year, stack, links, cover, gallery } = project.data;
---

<Base title={title} description={summary} noindex={!project.data.published}>
  <div class="wrap">
    <header class="page-head">
      <h1>{title}</h1>
      <p class="lede">{summary}</p>
    </header>

    <dl class="facts">
      {
        role && (
          <div>
            <dt>Status</dt>
            <dd>{role}</dd>
          </div>
        )
      }
      <div>
        <dt>Year</dt>
        <dd>{year}</dd>
      </div>
      {
        stack.length > 0 && (
          <div>
            <dt>Stack</dt>
            <dd>
              <ul class="dotted">
                {stack.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </dd>
          </div>
        )
      }
      {
        links.length > 0 && (
          <div>
            <dt>Links</dt>
            <dd>
              <ul class="dotted">
                {links.map((link) => (
                  <li>
                    <a href={link.href} rel="noopener">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        )
      }
    </dl>

    <div class="body">
      {
        cover && (
          <Image
            class="shot cover"
            src={cover.src}
            alt={cover.alt}
            widths={[736, 1472]}
            sizes="(min-width: 50rem) 736px, calc(100vw - 2.5rem)"
            loading="eager"
          />
        )
      }

      <article class="prose">
        <Content />
      </article>
    </div>

    {
      gallery.length > 0 && (
        <section class="shots" aria-labelledby="shots-label">
          <h2 class="label" id="shots-label">Screenshots</h2>
          <div class="gallery" role="group" tabindex="0" aria-label={`${title} screenshots`}>
            {gallery.map((item) => (
              <Image
                class="shot"
                src={item.src}
                alt={item.alt}
                widths={[176, 352, 528]}
                sizes="(min-width: 40rem) 175px, 44vw"
                loading="lazy"
              />
            ))}
          </div>
        </section>
      )
    }
  </div>
</Base>

<style>
  .body {
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }

  /* Image classes are applied to elements rendered by <Image>, so they need :global-free
     scoping via the shared data-astro-cid attribute, which Astro adds to them. */
  .shot {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  .cover {
    margin-bottom: 2rem;
  }

  .shots {
    display: grid;
    gap: 0.75rem;
    margin-top: 2.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule);
  }

  /* Four across, so three panels and four panels come out the same size. */
  .gallery {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    min-width: 0;
  }

  /* Small screens: one row that scrolls sideways and runs off the right edge of the screen. */
  @media (max-width: 39.99rem) {
    .gallery {
      display: flex;
      overflow-x: auto;
      margin-right: calc(-1 * var(--gutter));
      padding-right: var(--gutter);
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
    }

    .gallery .shot {
      flex: 0 0 max(9.5rem, 44vw);
      width: max(9.5rem, 44vw);
      scroll-snap-align: start;
    }
  }
</style>
