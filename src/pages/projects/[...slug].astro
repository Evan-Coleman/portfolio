---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, role, year, stack, links, cover, gallery } = project.data;
---

<Base title={title} description={summary} noindex={!project.data.published}>
  <div class="wrap">
    <header class="project-head">
      <p><a class="arrow-back" href="/projects">← Projects</a></p>
      <p class="label meta">{year}{role && ` · ${role}`}</p>
      <h1>{title}</h1>
      <p class="lede">{summary}</p>

      {
        links.length > 0 && (
          <p class="links">
            {links.map((link) => (
              <a class="btn btn--ghost" href={link.href} rel="noopener">
                {link.label}
              </a>
            ))}
          </p>
        )
      }

      {
        stack.length > 0 && (
          <ul class="chips stack" aria-label="Stack">
            {stack.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )
      }
    </header>

    {
      (cover || gallery.length > 0) && (
        <div class="shots">
          {cover && (
            <Image
              class="shot cover"
              src={cover.src}
              alt={cover.alt}
              widths={[960, 1920]}
              sizes="(min-width: 1168px) 1088px, calc(100vw - 2.5rem)"
              loading="eager"
            />
          )}
          {gallery.length > 0 && (
            <div class="gallery" role="group" tabindex="0" aria-label={`${title} screenshots`}>
              {gallery.map((item) => (
                <Image
                  class="shot"
                  src={item.src}
                  alt={item.alt}
                  widths={[440, 880]}
                  sizes="(min-width: 40rem) 355px, max(200px, 62vw)"
                  loading="lazy"
                />
              ))}
            </div>
          )}
        </div>
      )
    }

    <article class="prose">
      <Content />
    </article>
    <div class="end"></div>
  </div>
</Base>

<style>
  .project-head {
    padding-block: clamp(3rem, 8vw, 5rem) clamp(2rem, 5vw, 3rem);
  }

  .arrow-back {
    font-size: var(--step--1);
    text-decoration: none;
    color: var(--ink-2);
  }

  .arrow-back:hover {
    color: var(--accent);
  }

  .meta {
    margin-top: 2rem;
  }

  h1 {
    margin-top: 0.75rem;
    max-width: 22ch;
    font-size: var(--step-3);
    font-weight: 380;
    line-height: 1.06;
    letter-spacing: -0.028em;
  }

  .project-head .lede {
    margin-top: 1.25rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .stack {
    margin-top: 1.5rem;
  }

  .shots {
    display: grid;
    gap: 12px;
    margin-top: clamp(0.5rem, 2vw, 1rem);
    margin-bottom: clamp(2.5rem, 6vw, 3rem);
  }

  /* Image classes are applied to elements rendered by <Image>, so they need :global-free
     scoping via the shared data-astro-cid attribute, which Astro adds to them. */
  .shot {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: 14px;
  }

  .gallery {
    display: flex;
    gap: 12px;
    min-width: 0;
  }

  .gallery .shot {
    flex: 1 1 0;
    min-width: 0;
  }

  @media (max-width: 39.99rem) {
    .gallery {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
    }

    .gallery .shot {
      flex: 0 0 max(200px, 62vw);
      width: max(200px, 62vw);
      scroll-snap-align: start;
    }
  }

  .end {
    padding-bottom: 4rem;
  }
</style>
