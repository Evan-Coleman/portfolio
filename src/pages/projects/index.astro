---
import Base from '../../layouts/Base.astro';
import ProjectList from '../../components/ProjectList.astro';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
---

<Base
  title="Projects"
  description="Selected projects and write-ups."
  noindex={projects.length === 0}
>
  <div class="wrap">
    <header class="page-head">
      <h1>Projects</h1>
      <p class="lede">
        I build things because I want or need them myself. These are the ones I have put real work into, with notes
        on how they are built.
      </p>
    </header>

    {
      projects.length > 0 ? (
        <div class="list">
          <ProjectList projects={projects} level="h2" />
        </div>
      ) : (
        <p class="empty">No projects to show yet. Check back soon.</p>
      )
    }
  </div>
</Base>
