---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { getPosts, formatDate } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, tags } = post.data;
const url = new URL(`/blog/${post.id}/`, site.url).href;
const isoDay = (value: Date) => value.toISOString().slice(0, 10);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  ...(updated && { dateModified: updated.toISOString() }),
  author: { '@type': 'Person', name: site.name, url: site.url },
  url,
};
---

<Base title={title} description={description} type="article" schema={schema}>
  <div class="wrap">
    <header class="page-head">
      <p class="label">
        <time datetime={isoDay(date)}>{formatDate(date)}</time>
        {updated && <span> · Updated <time datetime={isoDay(updated)}>{formatDate(updated)}</time></span>}
      </p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
    </header>

    <article class="prose">
      <Content />
    </article>

    <footer class="post-foot">
      {
        tags.length > 0 && (
          <ul class="stack" aria-label="Tags">
            {tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
      <p>Questions or thoughts? <a href={`mailto:${site.email}`}>Reply by email</a>.</p>
    </footer>
  </div>
</Base>

<style>
  h1 {
    margin-top: 0.5rem;
  }

  .post-foot {
    display: grid;
    gap: 0.5rem;
    max-width: var(--measure);
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    font-size: var(--text-md);
    color: var(--ink-2);
  }
</style>
